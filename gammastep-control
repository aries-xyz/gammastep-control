#!/usr/bin/env python3
"""gammastep-control: GUI pequeña para la luz cálida de gammastep.

Escribe ~/.config/gammastep/config.ini y reinicia el indicador para que los
cambios surtan efecto, ya que gammastep no recarga la configuración en caliente.
"""

import configparser
import os
import shutil
import signal
import subprocess
import tempfile
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CONFIG_DIR = os.path.join(XDG_CONFIG, "gammastep")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.ini")
DAEMON = "gammastep"
INDICATOR = "gammastep-indicator" if shutil.which("gammastep-indicator") else DAEMON

TEMP_MIN, TEMP_MAX, TEMP_STEP = 1000, 10000, 50
DEFAULT_DAY, DEFAULT_NIGHT = 6500, 4500
PRESETS = ((6500, 2500), (6000, 3000), (5500, 4000), (6500, 4500))
PREVIEW_DELAY_MS = 150
DEVNULL = subprocess.DEVNULL


def _cmdline(pid):
    try:
        with open("/proc/{}/cmdline".format(pid), "rb") as handle:
            return handle.read().split(b"\0")
    except OSError:
        return []


def _ppid(pid):
    try:
        with open("/proc/{}/stat".format(pid), "rb") as handle:
            return int(handle.read().rsplit(b")", 1)[1].split()[1])
    except (OSError, IndexError, ValueError):
        return 0


def _find_process(*names):
    """Localiza un proceso por nombre de ejecutable.

    El indicador se lanza como "python3 /usr/bin/gammastep-indicator", así que
    hay que mirar todos los argumentos y no sólo argv[0].
    """
    me = os.getpid()
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me or _ppid(pid) == me:
            continue
        args = {os.path.basename(os.fsdecode(arg)) for arg in _cmdline(pid) if arg}
        if args & set(names):
            return pid
    return None


def stop_daemon(timeout=4.0):
    """Detiene el indicador y su proceso gammastep hijo. True si algo corría."""
    pids = [pid for pid in (_find_process("gammastep-indicator"), _find_process(DAEMON)) if pid]
    if not pids:
        return False
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not any(os.path.exists("/proc/{}".format(pid)) for pid in pids):
            return True
        time.sleep(0.05)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    return True


def start_daemon():
    subprocess.Popen([INDICATOR], stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL,
                     start_new_session=True)


def read_temp(parser, key, fallback):
    try:
        value = int(parser["general"].get(key, fallback))
    except ValueError:
        return fallback
    return max(TEMP_MIN, min(TEMP_MAX, value))


def write_config(parser):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    handle, tmp_path = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".config.ini.")
    try:
        with os.fdopen(handle, "w") as stream:
            parser.write(stream, space_around_delimiters=False)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, CONFIG_PATH)
    except BaseException:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise


def preview_temperature(temp):
    """Aplica la temperatura una sola vez (requiere que el daemon esté parado)."""
    subprocess.run([DAEMON, "-o", "-P", "-O", str(temp)],
                   stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL, check=False)


class ControlWindow(Gtk.Window):

    def __init__(self):
        super().__init__(title="Luz cálida · Gammastep")
        self.set_border_width(12)
        self.set_default_size(460, -1)
        self.set_resizable(False)

        self.parser = configparser.RawConfigParser()
        self.parser.optionxform = str
        try:
            self.parser.read(CONFIG_PATH)
        except configparser.Error as error:
            self._warn("No se pudo leer {}:\n{}\n\nSe usarán los valores por "
                       "defecto.".format(CONFIG_PATH, error))
        if not self.parser.has_section("general"):
            self.parser.add_section("general")

        self.saved_day = read_temp(self.parser, "temp-day", DEFAULT_DAY)
        self.saved_night = read_temp(self.parser, "temp-night", DEFAULT_NIGHT)

        self.suspended = False
        self.applied = False
        self.updating = False
        self.preview_source = None

        self._build()
        self._refresh_status()
        self.connect("delete-event", self._on_delete)
        self.show_all()

    # -- interfaz ---------------------------------------------------------

    def _build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        icon = Gtk.Image.new_from_icon_name("video-display", Gtk.IconSize.DIALOG)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="Luz cálida", xalign=0)
        title.get_style_context().add_class("h3")
        self.status_label = Gtk.Label(xalign=0)
        self.status_label.get_style_context().add_class("dim-label")
        titles.pack_start(title, False, False, 0)
        titles.pack_start(self.status_label, False, False, 0)
        header.pack_start(icon, False, False, 0)
        header.pack_start(titles, True, True, 0)
        root.pack_start(header, False, False, 0)

        self.day_scale, self.day_value = self._add_slider(root, "Día", self.saved_day)
        self.night_scale, self.night_value = self._add_slider(root, "Noche", self.saved_night)

        presets = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        presets.set_halign(Gtk.Align.START)
        presets_label = Gtk.Label(label="Preajustes:", xalign=0)
        presets_label.get_style_context().add_class("dim-label")
        presets.pack_start(presets_label, False, False, 0)
        for day, night in PRESETS:
            button = Gtk.Button(label="{} / {}".format(day, night))
            button.connect("clicked", self._on_preset, day, night)
            presets.pack_start(button, False, False, 0)
        root.pack_start(presets, False, False, 0)

        hint = Gtk.Label(
            label="6500 K es el blanco neutro. Bajar el valor = luz más cálida y rojiza.",
            xalign=0, wrap=True, max_width_chars=44)
        hint.get_style_context().add_class("dim-label")
        root.pack_start(hint, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        buttons.set_halign(Gtk.Align.END)
        self.reset_button = Gtk.Button(label="Descartar")
        self.reset_button.set_tooltip_text("Vuelve a los valores guardados en config.ini")
        self.reset_button.connect("clicked", self._on_reset)
        self.cancel_button = Gtk.Button(label="Cancelar")
        self.cancel_button.connect("clicked", lambda *_: self.destroy())
        self.apply_button = Gtk.Button(label="Aplicar y reiniciar")
        self.apply_button.get_style_context().add_class("suggested-action")
        self.apply_button.connect("clicked", self._on_apply)
        buttons.pack_start(self.reset_button, False, False, 0)
        buttons.pack_start(self.cancel_button, False, False, 0)
        buttons.pack_start(self.apply_button, False, False, 0)
        root.pack_start(buttons, False, False, 0)

        self.add(root)

    def _add_slider(self, parent, label_text, value):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        label = Gtk.Label(label=label_text, xalign=0)
        value_label = Gtk.Label(xalign=1)
        value_label.get_style_context().add_class("numeric")
        value_label.set_width_chars(9)
        row.pack_start(label, True, True, 0)
        row.pack_start(value_label, False, False, 0)

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, TEMP_MIN, TEMP_MAX, TEMP_STEP)
        scale.set_draw_value(False)
        scale.set_hexpand(True)
        scale.set_tooltip_text("Temperatura de color en kelvin")
        scale.add_mark(TEMP_MIN, Gtk.PositionType.LEFT, None)
        scale.add_mark(DEFAULT_DAY, Gtk.PositionType.BOTTOM, None)
        scale.add_mark(TEMP_MAX, Gtk.PositionType.RIGHT, None)
        scale.set_value(value)
        scale.connect("value-changed", self._on_value_changed)

        box.pack_start(row, False, False, 0)
        box.pack_start(scale, False, False, 0)
        parent.pack_start(box, False, False, 0)
        self._set_label(value_label, value)
        return scale, value_label

    @staticmethod
    def _set_label(label, temp):
        label.set_text("{:,} K".format(temp).replace(",", " "))

    def _refresh_status(self):
        if self.suspended:
            self.status_label.set_text("En vista previa · el indicador está detenido")
        elif _find_process(DAEMON) is None:
            self.status_label.set_text("Gammastep no está en ejecución")
        else:
            self.status_label.set_text("Indicador activo")

    def _warn(self, message):
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.CLOSE, text=message)
        dialog.run()
        dialog.destroy()

    def _error(self, message):
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE, text=message)
        dialog.run()
        dialog.destroy()

    # -- callbacks --------------------------------------------------------

    def _on_value_changed(self, scale):
        if self.updating:
            return
        label = self.day_value if scale is self.day_scale else self.night_value
        temp = int(round(scale.get_value()))
        self._set_label(label, temp)
        if self.preview_source is not None:
            GLib.source_remove(self.preview_source)
        self.preview_source = GLib.timeout_add(PREVIEW_DELAY_MS, self._do_preview, temp)

    def _do_preview(self, temp):
        self.preview_source = None
        if not self.suspended:
            stop_daemon()
            self.suspended = True
            self._refresh_status()
        preview_temperature(temp)
        return False

    def _on_preset(self, _button, day, night):
        self.updating = True
        self.day_scale.set_value(day)
        self.night_scale.set_value(night)
        self.updating = False
        self._on_value_changed(self.day_scale)
        self._on_value_changed(self.night_scale)

    def _on_reset(self, _button):
        self.updating = True
        self.day_scale.set_value(self.saved_day)
        self.night_scale.set_value(self.saved_night)
        self.updating = False
        self._set_label(self.day_value, self.saved_day)
        self._set_label(self.night_value, self.saved_night)
        self._restart_daemon()
        self._warn("Se restauraron los valores guardados.\n\n"
                   "Día: {} K\nNoche: {} K".format(self.saved_day, self.saved_night))

    def _on_apply(self, _button):
        if self.preview_source is not None:
            GLib.source_remove(self.preview_source)
            self.preview_source = None
        day = int(round(self.day_scale.get_value()))
        night = int(round(self.night_scale.get_value()))
        try:
            self.parser["general"]["temp-day"] = str(day)
            self.parser["general"]["temp-night"] = str(night)
            write_config(self.parser)
        except OSError as error:
            self._error("No se pudo escribir {}:\n{}".format(CONFIG_PATH, error))
            return
        self.saved_day, self.saved_night = day, night
        self._restart_daemon()
        self.applied = True
        self.destroy()

    def _restart_daemon(self):
        stop_daemon()
        start_daemon()
        self.suspended = False
        self._refresh_status()

    def _on_delete(self, *_args):
        if self.preview_source is not None:
            GLib.source_remove(self.preview_source)
            self.preview_source = None
        if self.suspended and not self.applied:
            start_daemon()
            self.suspended = False
        return False


def main():
    window = ControlWindow()
    window.connect("destroy", Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())